{
  "name": "siyuan-latex-paste",
  "version": "0.2.8",
  "private": true,
  "description": "SiYuan plugin: paste LaTeX and get real math formulas",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
